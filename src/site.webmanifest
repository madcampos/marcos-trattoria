			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/assets/icons/icon-192x192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},

		{
			"src": "/assets/icons/icon-mask.svg",
			"sizes": "any",
			"type": "image/svg+xml",
			"purpose": "maskable"
		},
		{
			"src": "/assets/icons/icon-mask-512x512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		},
		{
			"src": "/assets/icons/icon-mask-192x192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "maskable"
		},

		{
			"src": "/assets/icons/icon-mono.svg",
