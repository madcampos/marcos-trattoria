{
	"$schema": "https://www.schemastore.org/web-manifest-combined.json",
	"id": "/?id=45bd6ca0-c827-4e58-bce2-7a80ff0dce9b",

	"name": "Marco's Trattoria",
	"short_name": "Marco's",
	"description": "Marco's Trattoria — A delight in each bite",
	"categories": ["food", "restaurant", "italian", "pasta", "pizza"],

	"lang": "en-US",
	"dir": "ltr",

	"scope": "/",
	"scope_extensions": [{ "type": "origin", "origin": "https://trattoria.madcampos.dev/" }],
	"start_url": "/",

	"background_color": "#faebd7",
	"theme_color": "#2f4da7",
	"display": "minimal-ui",
	"orientation": "any",
	"display_override": ["window-controls-overlay", "minimal-ui", "browser"],

	"iarc_rating_id": "fc965bf1-bffc-4400-b558-881ddff7e498",
	"prefer_related_applications": false,
	"related_applications": [],

