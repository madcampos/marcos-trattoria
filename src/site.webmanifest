	"handle_links": "preffered",
	"launch_handler": { "client_mode": "navigate-existing" },
	"protocol_handlers": [{ "protocol": "web+trattoria", "url": "/recipes/?recipe=%s" }],

	"share_target": {
		"action": "/contact/",
		"method": "POST",
		"enctype": "application/x-www-form-urlencoded",
		"params": {
			"title": "title",
			"text": "text"
		}
	},

	"file_handlers": [
		{
			"action": "/book/",
			"accept": {
				"application/json": [".mtb"]
			},
			"icons": [
