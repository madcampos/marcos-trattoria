{
	"id": "/?id=45bd6ca0-c827-4e58-bce2-7a80ff0dce9b",
	"scope": "/",
	"start_url": "/",
	"scope_extensions": [{ "type": "origin", "origin": "https://trattoria.madcampos.dev/" }],
	"name": "Marco's Trattoria",
	"short_name": "Marco's",
	"lang": "en-US",
	"dir": "ltr",
	"description": "Marco's Trattoria — A delight in each bite",
	"categories": ["food", "restaurant", "italian", "pasta", "pizza"],
	"display": "minimal-ui",
	"orientation": "any",
	"background_color": "#252525",
	"theme_color": "#0080ff",
	"prefer_related_applications": false,
	"icons": [
		{
			"src": "/assets/icons/icon.svg",
			"sizes": "any",
			"type": "image/svg+xml",
			"purpose": "any"
		},
