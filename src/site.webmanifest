			"purpose": "monochrome"
		},
		{
			"src": "/assets/icons/icon-mono-512x512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "monochrome"
		},
		{
			"src": "/assets/icons/icon-mono-192x192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "monochrome"
		}
	],
	"shortcuts": [
